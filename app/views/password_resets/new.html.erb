<% content_for :title, "Reset password" %><div class="auth"><%= link_to "← Sign in", login_path, class: "back" %><h1>Reset your password</h1><p>Request a reset link for your account email.</p><%= form_with scope: :password_reset, url: password_resets_path, class: "stack" do |f| %><%= f.label :email %><%= f.email_field :email, required: true, autocomplete: "email" %><%= f.submit "Send reset link", class: "button solid" %><% end %></div>
