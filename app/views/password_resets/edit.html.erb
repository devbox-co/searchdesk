<% content_for :title, "Choose password" %><div class="auth"><h1>Choose a new password</h1><%= render "shared/errors", record: @user %><%= form_with scope: :user, url: password_reset_path(@token), method: :patch, class: "stack" do |f| %><%= f.label :password, "New password (at least 12 characters)" %><%= f.password_field :password, required: true, minlength: 12, autocomplete: "new-password" %><%= f.label :password_confirmation, "Confirm password" %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %><%= f.submit "Update password", class: "button solid" %><% end %></div>
