<% content_for :title, "Overview" %>
<header class="overview-header">
  <div><p class="overview-host"><%= ui_icon(:globe, size: 15) %><%= current_site.host %></p>
    <h1>Visibility overview</h1><p><%= current_site.name %> · <%= @today.strftime("%A, %-d %B %Y") %></p></div>
  <div class="toolbar"><%= link_to rank_icon_text(:calendar, "View schedules"), schedules_path, class: "button" %>
    <%= link_to rank_icon_text(:sparkles, "Today’s SEO review"), assistant_path, class: "button overview-assistant" %></div>
</header>
<% period = @performance.current %>
<section class="overview-kpis" aria-label="Visibility summary">
  <% {"clicks" => ["Search clicks", :search], "impressions" => ["Search impressions", :globe]}.each do |metric, (name, icon)| %>
    <% value = period&.dig(:metrics, metric) %>
    <article class="overview-kpi"><p><%= ui_icon(icon, size: 16) %><%= name %></p>
      <strong><%= value.nil? ? "—" : number_with_delimiter(value) %></strong>
      <small><%= period ? "#{period[:start].strftime('%-d %b')} – #{compact_date(period[:end])}" : "Awaiting Search Console" %></small>
      <% if (difference = period_change(value, @performance.previous&.dig(:metrics, metric))) %><span><%= difference %></span><% end %>
    </article>
  <% end %>
  <article class="overview-kpi"><p><%= ui_icon(:target, size: 16) %>Tracked keywords</p>
    <strong><%= current_site.keywords.size %></strong>
    <%= link_to rank_icon_text(:arrow_right, "View keyword rankings"), rankings_path %>
  </article>
</section>
<% if @latest_brief %>
  <%= render "overviews/daily_brief", brief: @latest_brief %>
<% end %>
<turbo-frame id="overview-filters" target="_top" data-turbo-action="advance" data-filter-frame="<%= current_site.id %>">
  <div id="local-visibility">
    <%= render "dashboard/map_visibility", visibility_map: @visibility_map %>
  </div>
  <div class="overview-charts">
    <%= render "overviews/search_chart" %>
    <%= render "overviews/rank_distribution" %>
  </div>
</turbo-frame>
<%= render "dashboard/site_audit_summary", audit: @latest_audit %>
