<% current = placement&.fetch(:current) %>
<% if current.nil? %>
  <span class="rank-sub">No comparable result</span>
<% else %>
  <% if current["position"] %>
    <strong class="rank-value">#<%= current["position"] %></strong>
    <% if current["type"] == "local_pack" %>
      <%= rank_feature_badge("Local pack", show_label: true) %>
      <small><%= link_to current["profile_name"], "https://www.google.com/maps/search/?#{ {api: 1, query: current["profile_name"], query_place_id: current["place_id"]}.to_query }",
        target: "_blank", rel: "noopener noreferrer" %></small>
    <% else %>
      <span class="rank-placement-type">Organic</span>
      <small><%= rank_page_link(current["url"]) %></small>
    <% end %>
  <% else %>
    <strong>Outside tracked results</strong>
  <% end %>
  <dl class="rank-placement-comparisons">
    <% [["Since last check", placement[:previous]], ["Since start", placement[:baseline]]].each do |label, comparison| %>
      <div>
        <dt><%= label %></dt>
        <dd>
          <% if comparison %>
            <% state = comparison.fetch(:transition)
              text = { entered: "Entered tracked results", left: "Left tracked results", outside_both: "Outside both checks" }.fetch(state) { movement_label(comparison) } %>
            <%= rank_change_badge(state, text) %>
            <small><%= compact_date(comparison[:day]) %><%= " · ##{comparison[:position]}" if comparison[:position] && state != :baseline %></small>
            <% if comparison[:type_changed] %><small><%= current["type"] == "local_pack" ? "Now in local pack" : "Now organic" %></small><% end %>
          <% else %>
            <span class="rank-sub">No prior check</span>
          <% end %>
        </dd>
      </div>
    <% end %>
  </dl>
<% end %>
