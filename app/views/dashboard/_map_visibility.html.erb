<% map_filters = request.query_parameters.slice("metric", "rank_device").select { |_key, v| %w[mobile desktop clicks impressions].include?(v) } %>
<section class="lf-card" id="maps-visibility" aria-labelledby="map-visibility-heading">
  <header class="lf-heading">
    <div><h2 id="map-visibility-heading">Google Maps visibility</h2>
      <p>Local Falcon · <%= current_site.location %></p></div>
    <% if visibility_map.options.any? %>
      <%= form_with url: dashboard_path(anchor: "maps-visibility"), method: :get, class: "lf-picker" do |form| %>
        <% map_filters.each do |key, value| %><%= hidden_field_tag key, value %><% end %>
        <%= form.label :map_scan, "Keyword and scan date" %>
        <div><%= form.select :map_scan, options_for_select(visibility_map.options.map { |key, term, date| ["#{term} · #{compact_date(date)}", key] }, visibility_map.scan.snapshot.external_id) %>
        <%= form.submit "Show scan", class: "button" %></div>
      <% end %>
    <% end %>
  </header>
  <% if (scan = visibility_map.scan) %>
    <% grid = visibility_map.grid; pins = grid.mapped_points; street = street_map_path(scan.snapshot) if grid.street_map_url; counts = visibility_map.counts %>
    <div class="lf-content">
      <div class="lf-geography" id="<%= dom_id(scan.snapshot, :geography) %>-<%= scan.snapshot.cache_version %>" data-saved-map>
        <% if pins.any? %>
          <fieldset class="lf-views">
            <legend class="lf-sr">Map view</legend>
            <% if street %>
              <input id="lf-street" type="radio" name="lf-view" class="lf-sr lf-mode" checked><label for="lf-street">Street map</label>
              <input id="lf-pins" type="radio" name="lf-view" class="lf-sr lf-mode"><label for="lf-pins">Pin grid</label>
              <p class="lf-map-notice" role="status" data-lf-map-unavailable hidden>Street map unavailable. Showing the saved pin grid. <button type="button" data-lf-retry>Retry street map</button></p>
              <figure class="lf-street"><img data-lf-street-image src="<%= street %>" width="1000" height="1000" decoding="async" referrerpolicy="no-referrer"
                alt="Google Maps ranks around <%= current_site.location %> for <%= scan.snapshot.keyword %>. The Pin grid view and coordinate table contain the individual rankings.">
                <figcaption class="lf-links"><%= link_to "Open full-size street map", street, target: "_blank", rel: "noopener" %></figcaption>
              </figure>
            <% end %>
            <figure class="lf-grid-view" aria-label="North-up local ranking grid">
              <div class="lf-grid" style="--grid-size:<%= scan.grid_size %>" role="img" aria-label="<%= pins.size %> observed locations. North is up. See the coordinate table for every reading.">
                <span class="lf-north" aria-hidden="true">↑ N</span>
                <% pins.each do |point| %>
                  <% rank = point["rank"]; band = case rank; when 1..3 then "top"; when 4..10 then "mid"; when 11..20 then "lower"; when "20+" then "outside"; else "missing"; end %>
                  <span class="lf-pin lf-pin-<%= band %>" style="left:<%= point['x'] %>%;top:<%= point['y'] %>%"
                    title="<%= point['lat'] %>, <%= point['lng'] %> · <%= rank ? "Rank #{rank}" : "No reported rank" %>"><%= rank || "–" %></span>
                <% end %>
              </div>
              <figcaption class="lf-key"><span><i class="lf-pin-top"></i>1–3</span><span><i class="lf-pin-mid"></i>4–10</span>
                <span><i class="lf-pin-lower"></i>11–20</span><span><i class="lf-pin-outside"></i>20+</span><span><i class="lf-pin-missing"></i>No rank</span></figcaption>
            </figure>
          </fieldset>
          <details class="lf-coordinates">
            <summary>Ranks at all <%= pins.size %> locations</summary>
            <div class="lf-table-scroll" role="region" aria-label="Scan coordinates" tabindex="0"><table>
              <thead><tr><th scope="col">Latitude</th><th scope="col">Longitude</th><th scope="col">Maps rank</th></tr></thead>
              <tbody><% pins.each do |point| %><tr><td><%= point["lat"] %></td><td><%= point["lng"] %></td><td><%= point["rank"] || "No reported rank" %></td></tr><% end %></tbody>
            </table></div>
          </details>
        <% else %>
          <div class="lf-empty"><%= ui_icon(:map_pin, size: 28) %><h3>Scan summary available</h3>
            <p>This saved report has no pin coordinates. A connected Local Falcon account can retrieve available pins for recent scans on its next sync.</p></div>
        <% end %>
      </div>
      <div class="lf-summary">
        <h3><%= scan.snapshot.keyword %></h3>
        <p class="lf-scope"><%= compact_date(scan.snapshot.observed_on) %><% if scan.grid_size %> · <%= scan.grid_size %> × <%= scan.grid_size %> grid<% end %><% if (radius = scan.radius) %> · <%= number_with_precision(radius.first, precision: 2, strip_insignificant_zeros: true) %> <%= radius.last %> radius<% end %></p>
        <div class="lf-metric">
          <p>Top-three coverage</p>
          <strong><%= scan.share.nil? ? "Unavailable" : number_to_percentage(scan.share, precision: 2, strip_insignificant_zeros: true) %></strong>
          <% if counts %><span>Ranked in the top three at <b><%= counts.first %> of <%= counts.last %></b> scanned locations.</span><% else %><span>Share of scanned locations where the business ranked first, second or third.</span><% end %>
        </div>
        <% if visibility_map.history.size > 1 %>
          <div class="lf-trend"><h4>Coverage over time</h4><p>Same keyword and grid locations</p>
            <ul><% visibility_map.history.each do |reading| %><li><%= link_to dashboard_path(map_filters.merge(map_scan: reading.snapshot.external_id, anchor: "maps-visibility")), aria: { current: ("true" if reading.snapshot.id == scan.snapshot.id) } do %>
              <time datetime="<%= reading.snapshot.observed_on.iso8601 %>"><%= reading.snapshot.observed_on.strftime("%d %b") %></time>
              <span class="lf-bar" aria-hidden="true"><i style="width:<%= reading.share %>%"></i></span>
              <b><%= number_to_percentage(reading.share, precision: 2, strip_insignificant_zeros: true) %></b>
            <% end %></li><% end %></ul>
          </div>
        <% end %>
        <div class="lf-links"><%= link_to "Open scan report", scan.report_url, target: "_blank", rel: "noopener noreferrer" %>
          <%= link_to "View Google Maps coverage", local_falcon_connection_path(anchor: "maps-scans") %></div>
      </div>
    </div>
  <% else %>
    <div class="lf-no-scans"><%= ui_icon(:map_pin, size: 24) %><div><h3>No saved Maps scans</h3>
      <p>Connect a Local Falcon account with a completed Google Maps scan to see its ranking grid here.</p>
      <%= link_to "View Google Maps coverage", local_falcon_connection_path(anchor: "maps-scans") %></div></div>
  <% end %>
</section>
