<% content_for :title, "Integration catalogue" %><div class="hero"><div><p class="eyebrow">Product capabilities</p><h1>Integration catalogue</h1><p>See which services support live data, external reports or planned adapters.</p></div><%= link_to "Sign in", login_path, class: "button solid" unless current_user %></div>
<%= render "source_choices", heading: "Which services do you need?" if params[:q].blank? %>
<%= form_with url: public_catalogue_path, method: :get, class: "filter" do |f| %><label>Find a service <%= search_field_tag :q, params[:q], placeholder: "For example, Local Falcon" %></label><%= f.submit "Search", class: "button" %><span><%= @entries.size %> of <%= IntegrationCatalogue::ROWS.size %> services</span><% end %>
<% if @entries.empty? %><p class="empty">No matching services. <%= link_to "Show all", public_catalogue_path %></p><% end %>
<div class="grid"><% @entries.each do |entry| %><article class="card"><small><%= entry.group %></small><h2><%= entry.name %></h2><span class="badge"><%= entry.mode %></span><p><%= entry.description %></p></article><% end %></div>
