<nav aria-label="Result pages" class="toolbar">
  <% if @page > 1 %><%= link_to "← Previous", url_for(request.query_parameters.merge(page: @page - 1)) %><% end %>
  <% if @page > 1 || @more %><span>Page <%= @page %></span><% end %>
  <% if @more %><%= link_to "Next →", url_for(request.query_parameters.merge(page: @page + 1)) %><% end %>
</nav>
