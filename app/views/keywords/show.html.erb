<% content_for :title, @keyword.phrase %>
<turbo-frame id="keyword-filters" class="rankings-view" target="_top" data-turbo-action="advance" data-filter-frame="<%= current_site.id %>">
  <%= link_to rank_icon_text(:arrow_left, "Rankings"), rankings_path(source: "local", device: @device), class: "rank-back" %>
  <header class="rank-heading"><div>
    <p class="rank-context"><%= rank_icon_text(:target, "Keyword history", size: 14) %></p><h1><%= @keyword.phrase %></h1>
    <p class="rank-intro"><%= current_site.location %> · Google · <%= current_site.language %> · top 30 organic results checked</p>
  </div><% if current_site.tracking_mode == "manual" && can_manage_site? %>
    <%= link_to rank_icon_text(:plus, "Import observation"), new_keyword_rank_import_path(@keyword, device: @device), class: "button solid" %>
  <% end %></header>

  <div class="rank-page-assignment" id="preferred-page"><div><span class="rank-assignment-label"><%= rank_icon_text(:flag, "Preferred page", size: 15) %></span>
      <% if @keyword.preferred_url.present? %><%= rank_page_link(@keyword.preferred_url) %><% else %><span>Unassigned</span><% end %></div>
    <% if can_manage_site? %><details class="rank-edit"><summary>Change preferred page</summary>
      <%= form_with scope: :keyword, url: preferred_page_keyword_path(@keyword), method: :patch do |f| %>
        <%= hidden_field_tag :device, @device %><%= f.label :preferred_url, "Page you want to rank for this search" %>
        <%= f.url_field :preferred_url, value: @keyword.preferred_url, maxlength: 2048 %>
        <%= f.submit "Save preferred page", class: "button" %>
      <% end %></details><% end %>
  </div>

  <section class="rank-panel">
    <div class="rank-panel-header"><div><h2>Observation history</h2>
      <p><% if @series %>Source · <%= @series.source == "demo" ? "Simulated demonstration" : @series.source.humanize %><% else %>Local organic rank<% end %></p></div>
      <nav class="rank-device-tabs" id="keyword-devices" aria-label="Ranking device"><% %w[mobile desktop].each do |device| %>
        <%= link_to rank_icon_text(device == "mobile" ? :smartphone : :monitor, device.capitalize), keyword_path(@keyword, device: device, range: @range, before: params[:before], anchor: "keyword-devices"),
          id: "keyword-rank-#{device}", data: { turbo_frame: "keyword-filters" }, aria: {current: device == @device ? "page" : nil} %>
      <% end %></nav>
    </div>
    <% if @series %><div class="rank-history-filters">
      <nav class="rank-device-tabs" id="keyword-periods" aria-label="History period"><% [["7", "7 days"], ["30", "30 days"], ["all", "All history"]].each do |value, label| %>
        <%= link_to label, keyword_path(@keyword, device: @device, range: value, anchor: "keyword-periods"),
          id: "keyword-range-#{value}", data: { turbo_frame: "keyword-filters" }, aria: {current: @range == value ? "page" : nil} %>
      <% end %></nav>
      <% if can_manage_site? %><%= button_to @series.paused? ? "Resume tracking" : "Pause tracking", keyword_path(@keyword), method: :patch, params: {tracking: @series.paused? ? "resume" : "pause", device: @device}, class: "button" %><% end %>
    </div><% if @series.paused? %><p class="rank-note" role="status"><%= rank_icon_text(:info, "Tracking is paused for this device.") %></p><% end %><% end %>

    <% if @slots.empty? %><div class="rank-empty">
        <% if @series&.baseline_observation %><h3>No observations in this period</h3><p>Choose a longer history period to see earlier observations.</p>
        <% else %><h3>Awaiting the first observation</h3><p>The baseline starts with the first complete reading for this location and device.</p><% end %>
      </div>
    <% else %><%= render "dashboard/rank_key", features: false %>
      <div class="rank-table-shell" tabindex="0" role="region" aria-label="Past observations">
      <table role="table" class="rank-table rank-history-table<%= ' rank-table-with-placement' if @placements %>"><thead role="rowgroup"><tr role="row"><th role="columnheader" scope="col">Observation date</th><% if @placements %><th role="columnheader" scope="col">Best result on Google</th><% end %><th role="columnheader" scope="col">Organic rank</th><th role="columnheader" scope="col">Organic movement</th><th role="columnheader" scope="col">Status</th></tr></thead><tbody role="rowgroup">
        <% @slots.each do |slot| %><% obs = slot.rank_observation
          baseline = @series.baseline_observation
          baseline = nil if baseline && baseline.day > slot.day
          change = if baseline&.position && obs&.position && baseline.day < slot.day
            baseline.position - obs.position
          end
          transition = Tracking::Dashboard.transition(baseline, obs, change)
          placement = @placements&.[](slot.id) %>
          <tr role="row"><th role="rowheader" scope="row" class="rank-term"><%= compact_date(slot.day) %>
              <% if obs %><small><%= obs.captured_at.in_time_zone(current_site.time_zone).strftime("%H:%M %Z") %></small><% end %>
              <% if obs&.winning_url.present? && placement&.dig(:current, "type") != "organic" %><span class="rank-sub">Ranking page · <%= rank_page_link(obs.winning_url) %></span><% end %></th>
            <% if @placements %><td role="cell" data-label="Best result on Google" class="rank-placement"><%= render "dashboard/google_placement", placement: placement %></td><% end %>
            <td role="cell" data-label="Organic rank"><strong class="rank-value"><%= rank_value(obs&.position, obs&.status) %></strong></td>
            <td role="cell" data-label="Organic movement"><%= rank_change_badge(transition, movement_label(transition: transition, change: change)) %></td>
            <td role="cell" data-label="Status"><%= (obs&.status || slot.status).humanize %><% if slot.reason.present? %><small><%= slot.reason %></small><% end %></td>
          </tr>
        <% end %></tbody>
      </table></div>
    <% end %>
    <% if @more %><p class="rank-pager"><%= link_to "Older observations", keyword_path(@keyword, device: @device, range: @range, before: @slots.last.day) %></p><% end %>
  </section>
  <div class="rank-footlinks"><%= link_to rank_icon_text(:file_text, "Evidence for this keyword"), source_snapshots_path(keyword: @keyword.phrase) %>
    <%= link_to rank_icon_text(:flag, "View keyword actions"), actions_path(keyword_id: @keyword.id) %></div>
</turbo-frame>
