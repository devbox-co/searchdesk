<% content_for :title, "Sign in" %><div class="auth"><p class="eyebrow">Account</p><h1>Sign in to Searchdesk</h1><p>Open your business's daily rankings and recommended actions.</p>
<%= form_with scope: :session, url: login_path, class: "stack" do |f| %><%= f.label :email %><%= f.email_field :email, required: true, autocomplete: "username", autofocus: true %><%= f.label :password %><%= f.password_field :password, required: true, autocomplete: "current-password" %><%= f.submit "Sign in", class: "button solid" %><% end %>
<div class="auth-links"><%= link_to "Create an account", signup_path %><%= link_to "Forgot password?", new_password_reset_path %></div>
<details id="public-catalogue" class="guide"><summary>Browse integrations (<%= IntegrationCatalogue::ROWS.size %>)</summary><ul class="shortlist"><% IntegrationCatalogue::ROWS.each do |entry| %><li><strong><%= entry.name %></strong> <small><%= entry.mode %></small></li><% end %></ul><%= link_to "Search the full catalogue", public_catalogue_path %></details></div>
