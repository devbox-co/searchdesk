<% content_for :title, "Create an account" %><div class="auth"><p class="eyebrow">Account</p><h1>Create your workspace</h1><p>Set up a private home for your business's keywords, observations and connections.</p>
<%= render "shared/errors", record: @user %><%= form_with scope: :user, url: signup_path, class: "stack" do |f| %>
<%= f.label :email %><%= f.email_field :email, value: @user&.email, required: true, autocomplete: "email", autofocus: true %>
<%= f.label :password, "Password (at least 12 characters)" %><%= f.password_field :password, required: true, minlength: 12, autocomplete: "new-password" %>
<%= f.label :password_confirmation, "Confirm password" %><%= f.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
<%= f.submit "Create account", class: "button solid" %><% end %>
<p><%= link_to "Already have an account? Sign in", login_path %></p></div>
