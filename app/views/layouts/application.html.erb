<!doctype html>
<html lang="en-GB">
<head>
  <title><%= content_for?(:title) ? "#{yield(:title)} · Searchdesk" : "Searchdesk · SEO workspace" %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= stylesheet_link_tag "/workspace.css" %>
  <%= javascript_importmap_tags %>
  <meta name="turbo-cache-control" content="no-cache">
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top"><div class="shell bar">
    <%= link_to "Searchdesk", current_user && current_site ? rankings_path : login_path, class: "brand" %>
    <% if current_user %>
      <div class="account">
        <% if current_site %><span class="site-tag"><%= current_site.name %></span><% end %>
        <details class="switcher"><summary>Workspace</summary><div class="switchmenu">
          <strong><%= current_user.email %></strong>
          <% unless current_user.email_verified_at %><%= link_to "Verify email address", new_email_verification_path %><% end %>
          <% available_sites.each do |site| %>
            <%= button_to site.name, select_site_path(site), method: :post, class: "menu-item", disabled: site == current_site %>
          <% end %>
          <% if can_manage_site? %><%= link_to "Set up a site", onboarding_path %><% end %>
          <% if current_site && workspace_owner? %><%= link_to "Workspace members", workspace_members_path %><% end %>
          <%= button_to "Sign out", logout_path, method: :delete, class: "menu-item" %>
        </div></details>
      </div>
    <% else %><%= link_to "Integrations", public_catalogue_path, class: "header-link" %><% end %>
  </div></header>
  <main id="main" class="shell">
    <% if current_user && current_site %>
      <nav class="primary-nav" aria-label="Workspace">
        <% [["Rankings", rankings_path, %w[dashboard keywords rank_imports]], ["Actions", actions_path, %w[keyword_actions action_drafts]], ["Integrations", integrations_path, %w[integrations search_console]]].each do |label, path, controllers| %>
          <%= link_to label, path, aria: {current: controllers.include?(controller_name) ? "page" : nil} %>
        <% end %>
      </nav>
    <% end %>
    <% flash.each do |kind, message| %><p class="flash <%= kind %>" role="status"><%= message %></p><% end %>
    <%= yield %>
  </main>
</body>
</html>
